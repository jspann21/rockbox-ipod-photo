# Themify 2 player adapted from 320x240 to the iPod Photo's 220x176 LCD.
# Original theme by Dook (2026).

%wd
%ax
%Fl(2,13-LeagueSpartan-Bold-Photo.fnt)
%Fl(3,11-LeagueSpartan-Medium-Photo.fnt)
%Fl(4,ipodphoto-icons.fnt,120)

# Navy/dominant canvas on the backdrop; foreground stays transparent.
%V(0,0,-,-,-)%VB%Vf(bg)%dr(0,0,-,-)
%V(0,0,-,-,-)

# Accent card, then an unconditional album-art declaration rendered through
# Rockbox's standard conditional-label pattern. Prime the album-art palette
# before resolving the card colour.
%?C<%Vd(Art)|>
%V(0,12,114,151,-)%Vf(fg)%dr(0,0,-,-)%Vf(bg)%dr(103,0,11,1)%dr(106,1,8,1)%dr(107,2,7,1)%dr(109,3,5,1)%dr(110,4,4,1)%dr(111,5,3,1)%dr(111,6,3,1)%dr(112,7,2,1)%dr(113,8,1,1)%dr(113,9,1,1)%dr(113,10,1,1)%dr(113,140,1,1)%dr(113,141,1,1)%dr(113,142,1,1)%dr(112,143,2,1)%dr(111,144,3,1)%dr(111,145,3,1)%dr(110,146,4,1)%dr(109,147,5,1)%dr(107,148,7,1)%dr(106,149,8,1)%dr(103,150,11,1)
%?C<%Vd(Art)|%Vd(No_Art)>

# Keep the cover's allocation square so aspect-preserving scaling leaves no
# letterbox strips. The following accent mask is the card's foreground frame:
# it sits above the cover and rounds only its exposed right-hand corners.
%Vl(Art,0,16,110,110,-)
%Cl(0,0,110,110,c,c)
%Cd
%Vl(Art,102,16,8,1,-)%Vf(fg)%dr(0,0,-,-)
%Vl(Art,105,17,5,1,-)%Vf(fg)%dr(0,0,-,-)
%Vl(Art,106,18,4,1,-)%Vf(fg)%dr(0,0,-,-)
%Vl(Art,107,19,3,1,-)%Vf(fg)%dr(0,0,-,-)
%Vl(Art,108,20,2,1,-)%Vf(fg)%dr(0,0,-,-)
%Vl(Art,109,21,1,1,-)%Vf(fg)%dr(0,0,-,-)
%Vl(Art,109,22,1,1,-)%Vf(fg)%dr(0,0,-,-)
%Vl(Art,109,23,1,1,-)%Vf(fg)%dr(0,0,-,-)
%Vl(Art,109,118,1,1,-)%Vf(fg)%dr(0,0,-,-)
%Vl(Art,109,119,1,1,-)%Vf(fg)%dr(0,0,-,-)
%Vl(Art,109,120,1,1,-)%Vf(fg)%dr(0,0,-,-)
%Vl(Art,108,121,2,1,-)%Vf(fg)%dr(0,0,-,-)
%Vl(Art,107,122,3,1,-)%Vf(fg)%dr(0,0,-,-)
%Vl(Art,106,123,4,1,-)%Vf(fg)%dr(0,0,-,-)
%Vl(Art,105,124,5,1,-)%Vf(fg)%dr(0,0,-,-)
%Vl(Art,102,125,8,1,-)%Vf(fg)%dr(0,0,-,-)

%Vl(No_Art,0,16,110,110,-)%Vf(muted)%dr(0,0,-,-)
%Vl(No_Art,102,16,8,1,-)%Vf(fg)%dr(0,0,-,-)
%Vl(No_Art,105,17,5,1,-)%Vf(fg)%dr(0,0,-,-)
%Vl(No_Art,106,18,4,1,-)%Vf(fg)%dr(0,0,-,-)
%Vl(No_Art,107,19,3,1,-)%Vf(fg)%dr(0,0,-,-)
%Vl(No_Art,108,20,2,1,-)%Vf(fg)%dr(0,0,-,-)
%Vl(No_Art,109,21,1,1,-)%Vf(fg)%dr(0,0,-,-)
%Vl(No_Art,109,22,1,1,-)%Vf(fg)%dr(0,0,-,-)
%Vl(No_Art,109,23,1,1,-)%Vf(fg)%dr(0,0,-,-)
%Vl(No_Art,109,118,1,1,-)%Vf(fg)%dr(0,0,-,-)
%Vl(No_Art,109,119,1,1,-)%Vf(fg)%dr(0,0,-,-)
%Vl(No_Art,109,120,1,1,-)%Vf(fg)%dr(0,0,-,-)
%Vl(No_Art,108,121,2,1,-)%Vf(fg)%dr(0,0,-,-)
%Vl(No_Art,107,122,3,1,-)%Vf(fg)%dr(0,0,-,-)
%Vl(No_Art,106,123,4,1,-)%Vf(fg)%dr(0,0,-,-)
%Vl(No_Art,105,124,5,1,-)%Vf(fg)%dr(0,0,-,-)
%Vl(No_Art,102,125,8,1,-)%Vf(fg)%dr(0,0,-,-)

# Inset seek bar. Its background is the muted full-track rail and its
# foreground is the elapsed portion, so %pb derives the split from elapsed /
# track length instead of obscuring either half with a pre-drawn rectangle.
%V(10,144,90,4,-)%Vb(muted)%Vf(bg)%pb(0,0,-,-,noborder)

# Rockpod status capsule. It grows leftward in 18-pixel slots for shuffle,
# repeat, and lossless/HQ while the battery remains flush to the right edge.
%V(0,0,1,1,-)%Vd(Status_Battery)%?bs<%Vd(Status_Long_Select)%?mh<%t(3)%Vd(Status_Hold);%t(3)%Vd(Status_Sleep)|%Vd(Status_Sleep)>|%?mh<%Vd(Status_Long_Select)%Vd(Status_Hold)|%Vd(Status_Short_Select)>>
%Vl(Status_Short_Select,0,0,1,1,-)%?and(%if(%ps,=,1),%if(%mm,>,1),%or(%if(%fc,=,4),%if(%fc,=,5),%if(%fc,=,7),%if(%fc,=,11)))<%Vd(Status_BG3)%Vd(Status_SRH)|%?and(%if(%ps,=,1),%if(%mm,>,1))<%Vd(Status_BG2)%Vd(Status_SR)|%?and(%if(%ps,=,1),%or(%if(%fc,=,4),%if(%fc,=,5),%if(%fc,=,7),%if(%fc,=,11)))<%Vd(Status_BG2)%Vd(Status_SH)|%?and(%if(%mm,>,1),%or(%if(%fc,=,4),%if(%fc,=,5),%if(%fc,=,7),%if(%fc,=,11)))<%Vd(Status_BG2)%Vd(Status_RH)|%?if(%ps,=,1)<%Vd(Status_BG1)%Vd(Status_S)|%?if(%mm,>,1)<%Vd(Status_BG1)%Vd(Status_R)|%?or(%if(%fc,=,4),%if(%fc,=,5),%if(%fc,=,7),%if(%fc,=,11))<%Vd(Status_BG1)%Vd(Status_H)|%Vd(Status_BG0)>>>>>>>>>>>>
%Vl(Status_Long_Select,0,0,1,1,-)%?and(%if(%ps,=,1),%if(%mm,>,1),%or(%if(%fc,=,4),%if(%fc,=,5),%if(%fc,=,7),%if(%fc,=,11)))<%Vd(Status_BG4)%Vd(Status_L_SRH)|%?and(%if(%ps,=,1),%if(%mm,>,1))<%Vd(Status_BG3)%Vd(Status_L_SR)|%?and(%if(%ps,=,1),%or(%if(%fc,=,4),%if(%fc,=,5),%if(%fc,=,7),%if(%fc,=,11)))<%Vd(Status_BG3)%Vd(Status_L_SH)|%?and(%if(%mm,>,1),%or(%if(%fc,=,4),%if(%fc,=,5),%if(%fc,=,7),%if(%fc,=,11)))<%Vd(Status_BG3)%Vd(Status_L_RH)|%?if(%ps,=,1)<%Vd(Status_BG2)%Vd(Status_L_S)|%?if(%mm,>,1)<%Vd(Status_BG2)%Vd(Status_L_R)|%?or(%if(%fc,=,4),%if(%fc,=,5),%if(%fc,=,7),%if(%fc,=,11))<%Vd(Status_BG2)%Vd(Status_L_H)|%Vd(Status_BG1)>>>>>>>>>>>>
